# Copie para .env neste pasta (ou use o .env da raiz do repo).
# Nunca commit o .env.

# Mesma URL do app (Settings → API → Project URL)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# ATENÇÃO: service_role — chave SECRETA do Dashboard → Settings → API
# (não é a anon / VITE_SUPABASE_ANON_KEY)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Mesma chave gerada no deploy (também no .env da raiz e nos secrets do Supabase)
ERP_SECRET_KEY=

